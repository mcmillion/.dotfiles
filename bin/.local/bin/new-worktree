#!/usr/bin/env bash
# -E so the ERR trap below still fires inside functions and subshells.
set -Eeuo pipefail

[[ -n "${NEW_WORKTREE_DEBUG:-}" ]] && set -x

# Create a new worktree branch in a bare-repo container layout, template any
# committed 1Password env files into it, then open it in herdr.
#
# Layout assumed (see clone-worktree-repo):
#   myrepo/
#     .bare/          bare clone (git common dir)
#     .git            file: "gitdir: ./.bare"
#     main/           worktree (default branch)
#     feat-foo/       worktrees, flat siblings of .bare
#
# Usage: new-worktree [branch-name]
#   branch-name omitted -> prompt for it.

warned=0
cleanup() {
  local ec=$?
  # Pane closes on exit; linger so warnings/errors stay readable. Read the
  # keypress from /dev/tty: pnpm and op leave stdin at EOF, which skips the wait.
  if [[ $ec -ne 0 || $warned -eq 1 ]]; then
    if [[ -e /dev/tty ]]; then
      read -n1 -rsp $'\npress any key to close...' </dev/tty || sleep 30
      echo
    else
      sleep 30
    fi
  fi
}
trap cleanup EXIT

# set -e exits mute, so a failing pane just vanishes. Name the line that died.
trap 'printf "\nfailed at line %s: %s\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

warn() {
  warned=1
  printf 'warning: %s\n' "$1" >&2
}

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

# Open $branch's worktree in herdr, focused. $1 is the on-disk path to point at
# if herdr isn't reachable. Uses the container as source (not a linked worktree).
# Labels the workspace with the prefix-stripped branch name (see $label).
open_in_herdr() {
  local fallback_path="$1"
  if command -v herdr >/dev/null 2>&1 && [[ -n "${HERDR_SOCKET_PATH:-}" ]]; then
    echo "opening in herdr..."
    herdr worktree open --cwd "$repo_root" --branch "$branch" --label "$label" --focus \
      || warn "herdr worktree open failed; worktree is at $fallback_path"
  else
    warn "herdr not running; worktree at $fallback_path (open it manually)"
  fi
}

# Walk up to the container dir that holds .bare/.
find_repo_root() {
  local dir="$1"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.bare" ]]; then
      echo "$dir"
      return
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

repo_root=$(find_repo_root "$PWD") \
  || die "not inside a bare-worktree repo (no .bare/ found walking up from $PWD)"

# Branch name: arg if given, else prompt.
branch="${1:-}"
if [[ -z "$branch" ]]; then
  read -rp "new branch: " branch
fi
branch="${branch#"${branch%%[![:space:]]*}"}"   # ltrim
branch="${branch%"${branch##*[![:space:]]}"}"   # rtrim
[[ -n "$branch" ]] || die "no branch name given"

git check-ref-format --branch "$branch" >/dev/null 2>&1 \
  || die "invalid branch name: $branch"

# Workspace label: drop a leading "prefix/" (e.g. mlm/, zc-1234/) so the herdr
# workspace shows just the descriptive part. No slash -> unchanged.
label="${branch#*/}"

branch_exists=0
if git -C "$repo_root/.bare" show-ref --verify --quiet "refs/heads/$branch"; then
  branch_exists=1
fi

# If the branch already has a worktree, there's nothing to create - just open
# that existing worktree in herdr and we're done.
if [[ $branch_exists -eq 1 ]]; then
  existing_wt=$(
    git -C "$repo_root/.bare" worktree list --porcelain \
      | awk -v b="refs/heads/$branch" '
          $1 == "worktree" { path=$2 }
          $1 == "branch" && $2 == b { print path; exit }
        '
  )
  if [[ -n "$existing_wt" ]]; then
    echo "branch '$branch' already checked out at $existing_wt; opening it..."
    open_in_herdr "$existing_wt"
    echo "done: $existing_wt"
    exit 0
  fi
fi

# Drop a leading "prefix/" (e.g. mlm/, zc-1234/) so the worktree folder is
# just the descriptive part; the branch itself keeps its full prefixed name.
# No slash -> unchanged.
dir_name="${branch#*/}"

# Slug the directory so worktrees stay flat siblings of .bare.
slug="$dir_name"
slug="${slug//\//-}"
slug=$(printf '%s' "$slug" | tr -c 'A-Za-z0-9._-' '-')
slug="${slug#-}"; slug="${slug%-}"
[[ -n "$slug" ]] || die "branch name slugged to empty: $branch"

new_path="$repo_root/$slug"
[[ ! -e "$new_path" ]] || die "target directory already exists: $new_path"

if [[ $branch_exists -eq 1 ]]; then
  # Existing branch, no worktree yet: check it out into a new sibling worktree.
  echo "creating worktree '$slug' for existing branch '$branch'..."
  git -C "$repo_root" worktree add "$new_path" "$branch" \
    || die "git worktree add failed"
else
  # New branch: fork it off the up-to-date default branch.
  default_branch=$(git -C "$repo_root/.bare" symbolic-ref --short HEAD) \
    || die "could not determine default branch from $repo_root/.bare"

  echo "fetching origin..."
  git -C "$repo_root/.bare" fetch origin

  echo "creating worktree '$slug' on new branch '$branch' from origin/$default_branch..."
  git -C "$repo_root" worktree add -b "$branch" "$new_path" "origin/$default_branch" \
    || die "git worktree add failed"
fi

# Ensure a live 1Password session, prompting interactively if there isn't one.
# In CLI-only mode (no desktop app) a session lasts 30 min of inactivity and is
# not extendable, so a cold pane needs a fresh sign-in. The OP_SESSION_* it
# exports is inherited by the op inject calls below. Returns non-zero if still
# not signed in. No --account, so it stays machine-neutral.
#
# A long 1Password password is easy to fat-finger, so give a few tries before
# giving up rather than burning the whole run on one typo. Only the interactive
# sign-in loop runs once per run (op_signin_done): once it's exhausted its
# retries there's no point re-prompting for every remaining template.
op_signin_max=3
op_signin_done=0
ensure_op_session() {
  op whoami >/dev/null 2>&1 && return 0
  [[ $op_signin_done -eq 1 ]] && return 1
  op_signin_done=1

  local attempt
  for ((attempt = 1; attempt <= op_signin_max; attempt++)); do
    echo "1Password session expired; signing in (attempt $attempt/$op_signin_max)..."
    eval "$(op signin)" || true
    op whoami >/dev/null 2>&1 && return 0
    [[ $attempt -lt $op_signin_max ]] && echo "sign-in failed - try again" >&2
  done
  return 1
}

# Template any committed 1Password env files (*.op.tpl) in the new worktree.
# Recursive, pruning heavy/irrelevant dirs. Best-effort: warn, keep going, but
# collect failures and report them loudly at the end so none slips past.
#
# find feeds the loop on fd 3, not stdin (mapfile isn't in macOS's bash 3.2). With
# a plain `find | while read` the loop body inherits the pipe as stdin, so op signin
# (inside ensure_op_session) reads the file list instead of prompting you, silently
# skipping every template after the first. fd 3 leaves stdin on the terminal.
failed_templates=()
while IFS= read -r -d '' tpl <&3; do
  out="${tpl%.op.tpl}"
  rel="${tpl#"$new_path"/}"
  tmp="$out.op.tmp.$$"
  echo "templating ${out#"$new_path"/} from 1Password..."
  if ! ensure_op_session; then
    failed_templates+=("${out#"$new_path"/}")
    warn "not signed in to 1Password - $rel not rendered"
    continue
  fi
  if op inject -i "$tpl" -o "$tmp"; then
    mv -f "$tmp" "$out"
  else
    rm -f "$tmp"
    failed_templates+=("${out#"$new_path"/}")
    warn "op inject failed for $rel - env not written"
  fi
done 3< <(
  find "$new_path" \
    \( -name .git -o -name .bare -o -name node_modules -o -name vendor \) -prune \
    -o -type f -name '*.op.tpl' -print0
)

# Loud, itemized summary of anything not rendered. warn() sets warned=1, so the
# pane lingers on the way out and this stays on screen.
if [[ ${#failed_templates[@]} -gt 0 ]]; then
  warn "these env files were NOT written from 1Password:"
  for f in "${failed_templates[@]}"; do
    printf '           %s\n' "$f" >&2
  done
  warn "sign in to 1Password, then run 'pnpm env:pull' in the worktree"
fi

# Install dependencies so the worktree is ready to run. Guarded on the repo
# actually using pnpm, so this stays a no-op in non-JS repos. Runs after
# templating in case a postinstall step reads the env we just rendered.
# Best-effort: a failed install warns (and lingers) but still opens the worktree.
if [[ -f "$new_path/pnpm-lock.yaml" ]] && command -v pnpm >/dev/null 2>&1; then
  echo "installing dependencies (pnpm install)..."
  if ! (cd "$new_path" && pnpm install); then
    warn "pnpm install failed - run it by hand in the worktree"
  fi
fi

open_in_herdr "$new_path"

echo "done: $new_path"
