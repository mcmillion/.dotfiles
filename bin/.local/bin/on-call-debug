#!/usr/bin/env bash
set -euo pipefail

# Bootstrap an on-call debugging context in herdr: pull the relevant repos and
# open a claude pane with all of them loaded (cwd frontend, rest via --add-dir).
#
# Each run adds a new "debug" tab to a shared "on-call" workspace, so multiple
# incidents can run side by side. Rename tabs to the incident as you go.
# The /on-call-debug skill drives the actual investigation inside claude.

BASE_DIR="$HOME/Developer/galileo-inc"
WORKSPACE_LABEL="on-call"

# Repos loaded into the claude session. First entry is the claude cwd; the rest
# load via --add-dir. Each gets a dedicated "oncall" worktree pinned to latest
# default branch (see provision_oncall) so an investigation reads shipped code
# and never fights another agent over the shared default-branch worktree.
REPOS=(
  frontend-monorepo
  api
  core-api
  health-ios
  health-android
  dna
)

warned=0
cleanup() {
  local ec=$?
  # Launcher pane closes on exit; linger so warnings/errors stay readable.
  if [[ $ec -ne 0 || $warned -eq 1 ]]; then
    read -n1 -rsp $'\npress any key to close...' || true
    echo
  fi
}
trap cleanup EXIT

warn() {
  warned=1
  printf 'warning: %s\n' "$1" >&2
}

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

command -v herdr >/dev/null 2>&1 && [[ -n "${HERDR_SOCKET_PATH:-}" ]] \
  || die "herdr server not reachable; can't bootstrap the on-call workspace"
command -v jq >/dev/null 2>&1 || die "jq not found"

# Ensure a dedicated "oncall" worktree for a repo, pinned to latest default
# branch, and append its path to ONCALL_DIRS. Layout is auto-detected:
#   bare-repo container (.bare/ present) -> oncall worktree at <repo>/oncall
#   plain clone (e.g. dna)               -> sibling worktree at <repo>-oncall
# Detached at origin/<default>: the default branch is already checked out in the
# repo's default worktree and git won't check a branch out twice. Permanent -
# created once, then hard-reset to latest on every run.
provision_oncall() {
  local repo="$1"
  local repo_dir="$BASE_DIR/$repo"
  [[ -d "$repo_dir" ]] || { warn "$repo_dir not found, skipping"; return 1; }

  local gitdir container oncall_path default
  if [[ -d "$repo_dir/.bare" ]]; then
    gitdir="$repo_dir/.bare"
    container="$repo_dir"
    oncall_path="$repo_dir/oncall"
    default=$(git -C "$gitdir" symbolic-ref --short HEAD) \
      || { warn "could not resolve default branch for $repo"; return 1; }
  else
    gitdir="$repo_dir"
    container="$repo_dir"
    oncall_path="$BASE_DIR/$repo-oncall"
    default=$(git -C "$gitdir" rev-parse --abbrev-ref origin/HEAD 2>/dev/null)
    default="${default#origin/}"
    [[ -n "$default" ]] || default="main"
  fi

  echo "refreshing $repo oncall worktree (origin/$default)..."
  git -C "$gitdir" fetch --quiet origin || warn "fetch failed for $repo (continuing)"

  if [[ -d "$oncall_path" ]]; then
    git -C "$oncall_path" reset --hard "origin/$default" \
      || warn "could not refresh $oncall_path"
  else
    git -C "$container" worktree add --detach "$oncall_path" "origin/$default" \
      || { warn "worktree add failed for $repo"; return 1; }
  fi

  ONCALL_DIRS+=("$oncall_path")
}

ONCALL_DIRS=()
for repo in "${REPOS[@]}"; do
  provision_oncall "$repo" || true
done

[[ ${#ONCALL_DIRS[@]} -gt 0 ]] || die "no oncall worktrees provisioned; can't start claude"

# cwd is the first repo's oncall worktree; the rest load via --add-dir.
frontend_dir="${ONCALL_DIRS[0]}"

# Build the claude command: herdr sets cwd, other worktrees load via --add-dir.
add_dirs=()
for dir in "${ONCALL_DIRS[@]:1}"; do
  add_dirs+=(--add-dir "$dir")
done
claude_cmd="claude"
for arg in "${add_dirs[@]}"; do
  claude_cmd+=" $(printf '%q' "$arg")"
done

# Reuse the on-call workspace if it exists, else create it.
ws_id=$(herdr workspace list \
  | jq -r --arg l "$WORKSPACE_LABEL" \
      'first(.result.workspaces[] | select(.label==$l) | .workspace_id) // empty')

if [[ -z "$ws_id" ]]; then
  echo "creating '$WORKSPACE_LABEL' workspace..."
  created=$(herdr workspace create --label "$WORKSPACE_LABEL" \
    --cwd "$frontend_dir" --focus)
else
  echo "adding debug tab to '$WORKSPACE_LABEL' workspace..."
  created=$(herdr tab create --workspace "$ws_id" --label debug \
    --cwd "$frontend_dir" --focus)
fi

pane_id=$(jq -r '.result.root_pane.pane_id' <<<"$created")
tab_id=$(jq -r '.result.tab.tab_id' <<<"$created")
[[ -n "$pane_id" && "$pane_id" != "null" ]] \
  || die "could not determine new pane id from herdr response"

# First-run tab inherits the workspace default label; normalize it.
herdr tab rename "$tab_id" debug >/dev/null 2>&1 || true

herdr pane run "$pane_id" "$claude_cmd" \
  || die "failed to start claude in pane $pane_id"

echo "on-call debug tab ready."
