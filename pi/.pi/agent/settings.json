{
  "theme": "onedark-darker",
  "tuiMode": "fullscreen",
  "shellPath": "~/.local/bin/pi-bash",
  "shellCommandPrefix": "if command -v brew >/dev/null 2>&1; then _pi_gnubin=\"$(brew --prefix coreutils 2>/dev/null)/libexec/gnubin\"; [ -d \"$_pi_gnubin\" ] && PATH=\"$_pi_gnubin:$PATH\"; unset _pi_gnubin; fi",
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.5",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-6-astra"
  ],
  "enableSkillCommands": true,
  "lastChangelogVersion": "1.0.0",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-powerline-footer"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "separator": "dot",
    "welcome": false,
    "path": {
      "mode": "basename"
    },
    "model": {
      "display": "name",
      "showThinkingLevel": false
    },
    "customItems": [
      {
        "id": "thinking_value",
        "statusKey": "thinking-value"
      }
    ],
    "layout": {
      "left": [
        "path",
        "git",
        "model",
        "custom:thinking_value",
        "context_pct",
        "extension_statuses"
      ],
      "right": [],
      "secondary": []
    }
  },
  "deviceId": "2ec2f6b5-2057-42dd-8974-bf9b147972be"
}