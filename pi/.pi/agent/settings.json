{
  "theme": "onedark-darker",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-6-astra"
  ],
  "enableSkillCommands": true,
  "skills": [
    "~/.claude/skills"
  ],
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-powerline-footer"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "separator": "dot",
    "welcome": false,
    "path": {
      "mode": "basename"
    },
    "model": {
      "display": "name",
      "showThinkingLevel": false
    },
    "customItems": [
      {
        "id": "thinking_value",
        "statusKey": "thinking-value"
      }
    ],
    "layout": {
      "left": [
        "path",
        "git",
        "model",
        "custom:thinking_value",
        "context_pct",
        "extension_statuses"
      ],
      "right": [],
      "secondary": []
    }
  }
}